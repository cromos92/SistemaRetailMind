# =============================================================================
# ARCHIVO DE EJEMPLO - VARIABLES DE ENTORNO RETAILMIND
# =============================================================================
# Copia este archivo como ".env" y configura tus valores reales
#
# IMPORTANTE: 
# - Este archivo NO debe subirse a GitHub (debe estar en .gitignore)
# - En producción, configura estas variables en tu plataforma de hosting
#   (Railway, Render, Heroku, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRESQL LOCAL (Base de datos de la aplicación Django)
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=tu_base_de_datos
PG_USER=postgres
PG_PASSWORD=tu_password

# -----------------------------------------------------------------------------
# MYSQL REMOTO (Base de datos origen para migración)
# -----------------------------------------------------------------------------
MYSQL_HOST=tu_host_mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tu_database
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password

# -----------------------------------------------------------------------------
# DJANGO SETTINGS
# -----------------------------------------------------------------------------
SECRET_KEY=genera-una-key-segura-aqui
DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE EMAIL - ELIGE UNA OPCIÓN
# -----------------------------------------------------------------------------

# === OPCIÓN 1: Gmail (Recomendado para producción) ===
# Genera un "App Password" en: https://myaccount.google.com/security
# 1. Habilita verificación en 2 pasos
# 2. Ve a "Contraseñas de aplicaciones"
# 3. Genera una nueva para "Correo"
# 4. Usa el código de 16 dígitos aquí:


# === OPCIÓN 2: MailerSend ===
# Configura tu dominio en: https://app.mailersend.com/domains
# Genera un token SMTP en: https://app.mailersend.com/settings/api-keys
# IMPORTANTE: Usa un token de PRODUCCIÓN, no de prueba

# EMAIL_HOST=smtp.mailersend.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=MS_xxxxx@trial-xxxxx.mlsender.net
# EMAIL_HOST_PASSWORD=tu_token_mailersend
# DEFAULT_FROM_EMAIL=MS_xxxxx@trial-xxxxx.mlsender.net

# === OPCIÓN 3: SendGrid ===
# Registrate en: https://sendgrid.com/
# Genera un API Key en: https://app.sendgrid.com/settings/api_keys

# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=tu_sendgrid_api_key
# DEFAULT_FROM_EMAIL=tu-email@tudominio.com

# -----------------------------------------------------------------------------
# NOTAS PARA PRODUCCIÓN
# -----------------------------------------------------------------------------
# 1. Railway: Ve a tu proyecto → Variables → Add Variable
# 2. Render: Ve a Environment → Add Environment Variable
# 3. Heroku: heroku config:set EMAIL_HOST=smtp.gmail.com --app tu-app
# 4. Vercel: Ve a Settings → Environment Variables
#
# 5. Después de agregar las variables, REINICIA el servidor
