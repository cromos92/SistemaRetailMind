### Código JavaScript de Auto-conexión

```javascript
document.addEventListener('DOMContentLoaded', function() {
    setTimeout(async function() {
        try {
            // Verificar configuración
            const config = window.verificarConfiguracionPOS();
            
            if (!config.configured) {
                $('#estado_pos').text('No Configurado').css('background-color', 'orange');
                return;
            }
            
            // Auto-conectar
            const resultado = await window.autoconectarPOSPre();
            
            if (resultado && resultado.connected) {
                $('#estado_pos').text('Conectado').css('background-color', 'green');
                $('#puerto').text(resultado.port || 'USB');
            }
        } catch (e) {
            console.log('POS no conectado:', e.message);
        }
    }, 1500);
});
```

